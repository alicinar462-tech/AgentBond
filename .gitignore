# ── Secrets and credentials ───────────────────────────────────────────────────
.env
.env.*
.env.local
.env.*.local

# Circle entity secret recovery files
contracts/.circle/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/

# Foundry build artifacts and cache (regenerated by `forge build`)
contracts/out/
contracts/cache/

# ── Test and deploy runtime files ─────────────────────────────────────────────
# Compass fork-verify receipt (regenerated by --mode verify)
contracts/.compass-verify/

# Compass deploy lock (overwritten on each deploy; not a source file)
contracts/deploy.lock.json

